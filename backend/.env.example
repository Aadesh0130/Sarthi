# =========================================================
# Sarthi backend configuration
# Copy this file to `.env` in the backend/ folder and adjust.
# The core experience (search, map, nearby places, routes, weather,
# recommendations, itineraries, cultural info) needs NO API key at all.
# Everything below the "optional" line requires a key you paste in
# yourself -- until then, that one feature honestly reports itself as
# "not configured" instead of faking a result. Nothing here is ever
# committed to Git (.env is in .gitignore).
# =========================================================

# --- App ---
APP_NAME=Sarthi API
ENVIRONMENT=development
# Comma-separated list of origins allowed to call this API from the browser.
# The Explore/Planner pages are usually opened as static files (file:// or
# a simple http server) so "*" is fine for a local SIH demo.
CORS_ORIGINS=*

# --- Database ---
# Defaults to a local SQLite file so the project runs with zero setup.
# For the full PostGIS-backed setup described in the project brief, point
# this at a real Postgres+PostGIS instance instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://sarthi:sarthi@localhost:5432/sarthi
DATABASE_URL=sqlite:///./sarthi.db

# --- Free map / geo / weather / culture stack (no keys required) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a descriptive User-Agent that identifies
# your app and, ideally, a contact. Replace the email before heavy/public use.
NOMINATIM_USER_AGENT=Sarthi-SIH-Prototype/1.0 (contact: set-your-email@example.com)
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WIKIDATA_BASE_URL=https://www.wikidata.org/w/api.php
WIKIPEDIA_BASE_URL=https://en.wikipedia.org/api/rest_v1

# --- Caching (seconds) ---
CACHE_TTL_GEOCODE=86400
CACHE_TTL_PLACES=3600
CACHE_TTL_WEATHER=1800
CACHE_TTL_ROUTE=3600
CACHE_TTL_EVENTS=3600
CACHE_TTL_HOTELS=900
CACHE_TTL_IMAGES=86400
CACHE_TTL_CULTURE=604800

# =========================================================
# Everything below is OPTIONAL. Leave a key blank and that feature reports
# "not configured" and gracefully degrades -- it never fakes a result.
# =========================================================

# --- AI Travel Assistant: pick ONE provider ---
# AI_PROVIDER selects which key below is actually used. Only the selected
# provider needs a key; the other can stay blank.
AI_PROVIDER=
# Set at https://platform.openai.com/api-keys (paid, has a free trial credit)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-
# Set at https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Events (Ticketmaster Discovery API) ---
# Free self-serve key: https://developer-acct.ticketmaster.com/user/register
# Coverage for Indian cities is genuinely limited -- an empty result is
# expected and honest, not a bug.
TICKETMASTER_API_KEY=


# --- Hotels (Hotelbeds / HBX Group) ---
# Self-serve sandbox signup: https://developer.hotelbeds.com
# IMPORTANT: a freshly registered account gets "evaluation" credentials
# capped at ~50 requests/day against the TEST environment below. Raising
# that requires going through Hotelbeds' certification process on their
# partner dashboard -- there is no code-side workaround.
HOTELBEDS_API_KEY=
HOTELBEDS_SECRET=
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com

# --- Images (Unsplash) ---
# Free "Demo" app, self-serve: https://unsplash.com/developers
# Demo tier is rate-limited to 50 requests/hour.
UNSPLASH_ACCESS_KEY=

# =========================================================
# Authentication (merged from the uploaded frontend project's own auth
# backend -- app/models/user.py, otp.py, trip.py, services/auth_service.py,
# sms_service.py, core/security.py). Real phone-OTP + Google Sign-In + JWT
# sessions -- these settings now live in the SAME Settings class as
# everything above (app/core/config.py), not a second config file.
# =========================================================
JWT_SECRET=change_this_to_a_long_random_string_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Sign in with Google (optional) -- https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AUTH_DEV_MODE=true (or missing Twilio credentials below) prints the OTP to
# the BACKEND SERVER'S OWN CONSOLE ONLY -- never to the browser console or
# any API response -- so phone login is testable with zero setup. Set to
# false and fill in real Twilio credentials to send actual SMS.
AUTH_DEV_MODE=true
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

OTP_EXPIRE_MINUTES=5
RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=5
OTP_SALT=change_this_otp_salt_in_production
